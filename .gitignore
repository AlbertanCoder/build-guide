__pycache__/
*.py[cod]
.venv/
flight-log.jsonl

# Blender build logs are throwaway output, not source
scripts/build/*.log
scripts/build/*.err

# Standalone single-file builds are generated, not source
dist/

# API keys live here and must never be committed
server/.env
*.env.local
server/.settings.json

# Answers already paid for: useful locally, never committed
server/.cache/

# Conversation memory: the user's own threads, mirrored from the page
server/.conversations/

# What the assistant remembers, synced ticks, paired phones (token hashes) and the month's spend (job 8)
server/.memory/

# 3D views made on request: rebuilt from their plan, never committed
server/.renders/
