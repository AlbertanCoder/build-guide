# Guide Assistant — server configuration
#
# Copy this file to  server/.env  and fill in ONE of the routes below.
# The key never reaches the browser: the page only ever talks to
# http://localhost:8790/api/ask.
#
# Then run:   node server/assistant-server.js
# and open:   http://localhost:8790/

# ─────────────────────────────────────────────────────────────────────────────
# ROUTE 1 — a hosted API (recommended: cheapest, no GPU, works immediately)
# Any OpenAI-compatible provider works. Uncomment one block.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI
# PROVIDER=openai
# BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini
# API_KEY=sk-...

# Groq (very fast, generous free tier)
# PROVIDER=openai
# BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile
# API_KEY=gsk_...

# OpenRouter (one key, many models)
# PROVIDER=openai
# BASE_URL=https://openrouter.ai/api/v1
# MODEL=anthropic/claude-3.5-haiku
# API_KEY=sk-or-v1-...

# DeepSeek (cheap, strong)
# PROVIDER=openai
# BASE_URL=https://api.deepseek.com/v1
# MODEL=deepseek-chat
# API_KEY=sk-...

# Mistral
# PROVIDER=openai
# BASE_URL=https://api.mistral.ai/v1
# MODEL=mistral-small-latest
# API_KEY=...

# Anthropic (native Messages API)
# PROVIDER=anthropic
# BASE_URL=https://api.anthropic.com
# MODEL=claude-3-5-haiku-latest
# API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────────────
# ROUTE 2 — a local model, no key and no cost (needs a decent machine)
# Ollama:            ollama pull qwen2.5:7b     then   ollama serve
# LM Studio:         start the local server on port 1234
# ─────────────────────────────────────────────────────────────────────────────

# PROVIDER=openai
# BASE_URL=http://127.0.0.1:11434/v1
# MODEL=qwen2.5:7b
# API_KEY=ollama

# LM Studio (OpenAI-compatible)
# PROVIDER=openai
# BASE_URL=http://127.0.0.1:1234/v1
# MODEL=local-model
# API_KEY=lm-studio

# ─────────────────────────────────────────────────────────────────────────────
# Cost control — every value here is optional; the defaults are the cheap ones
# ─────────────────────────────────────────────────────────────────────────────

# Two tiers. Leave both unset and the server uses a cheap model plus a stronger
# one that it only reaches for when a question needs it. Set MODEL alone and both
# tiers collapse to that one model (no surprise second vendor).
# CHEAP_MODEL=gpt-6-luna
# STRONG_MODEL=gpt-6.1-terra

# Hard stop. 0 or unset means no cap. When reached, the page silently falls back
# to its own offline answers instead of spending.
# DAILY_USD_MAX=0.25

# Answer cache: a question already answered is replayed for free.
# CACHE=off to disable, CACHE_TTL_DAYS=30, CACHE_MAX=400 entries.
# CACHE_FILE defaults to server/.cache/answers.json (git-ignored).

# Ask the provider to cache the static prompt prefix (Anthropic only; the block
# must clear that model's minimum cacheable length or nothing is cached).
# PROMPT_CACHE=1

# How much context is paid for per question.
# PASSAGE_CHARS=600      per passage, after sentence selection
# PASSAGE_TOTAL=2600     total characters of passages
# PASSAGE_COUNT=3        passages actually sent (the page may offer more)
# HISTORY_TURNS=2        verbatim turns kept, older ones become a one-line recap

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
# Settings saved from the page (the gear in the assistant panel) are written to
# .settings.json next to this file. That file is git-ignored and WINS over the
# values above. Set SETTINGS_FILE only to use a different location; the test
# suite does exactly that so it can never overwrite a real saved key.
# SETTINGS_FILE=server/.settings.json

# Where the server listens. The default (127.0.0.1) is this machine only, and
# that IS one of the three write gates (decision 14). On a VPS or a tailnet,
# bind wider — and then the other two gates below become mandatory.
# BIND=0.0.0.0

# Write gates 2 and 3 (required whenever BIND is not loopback):
#   ALLOW_WRITE / --allow-write : without it the server is read-only
#   GA_WRITE_TOKEN              : the page sends it as x-write-token; writes
#                                 without it (or with the wrong one) are refused
# ALLOW_WRITE=1
# GA_WRITE_TOKEN=replace-with-a-long-random-string

PORT=8790
