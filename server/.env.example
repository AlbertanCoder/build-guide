# Guide Assistant — server configuration
#
# Copy this file to  server/.env  and fill in ONE of the routes below.
# The key never reaches the browser: the page only ever talks to
# http://localhost:8790/api/ask.
#
# Then run:   node server/assistant-server.js
# and open:   http://localhost:8790/

# ─────────────────────────────────────────────────────────────────────────────
# ROUTE 1 — a hosted API (recommended: cheapest, no GPU, works immediately)
# Any OpenAI-compatible provider works. Uncomment one block.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI
# PROVIDER=openai
# BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini
# API_KEY=sk-...

# Groq (very fast, generous free tier)
# PROVIDER=openai
# BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile
# API_KEY=gsk_...

# OpenRouter (one key, many models)
# PROVIDER=openai
# BASE_URL=https://openrouter.ai/api/v1
# MODEL=anthropic/claude-3.5-haiku
# API_KEY=sk-or-v1-...

# DeepSeek (cheap, strong)
# PROVIDER=openai
# BASE_URL=https://api.deepseek.com/v1
# MODEL=deepseek-chat
# API_KEY=sk-...

# Mistral
# PROVIDER=openai
# BASE_URL=https://api.mistral.ai/v1
# MODEL=mistral-small-latest
# API_KEY=...

# Anthropic (native Messages API)
# PROVIDER=anthropic
# BASE_URL=https://api.anthropic.com
# MODEL=claude-3-5-haiku-latest
# API_KEY=sk-ant-...

# ─────────────────────────────────────────────────────────────────────────────
# ROUTE 2 — a local model, no key and no cost (needs a decent machine)
# Ollama:            ollama pull qwen2.5:7b     then   ollama serve
# LM Studio:         start the local server on port 1234
# ─────────────────────────────────────────────────────────────────────────────

# PROVIDER=openai
# BASE_URL=http://127.0.0.1:11434/v1
# MODEL=qwen2.5:7b
# API_KEY=ollama

# LM Studio (OpenAI-compatible)
# PROVIDER=openai
# BASE_URL=http://127.0.0.1:1234/v1
# MODEL=local-model
# API_KEY=lm-studio

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=8790
